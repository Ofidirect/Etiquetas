<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3"
      crossorigin="anonymous"
    />
    <link rel="shortcut icon" href="logo_1.ico" type="image/x-icon" />

    <title>Impresión Etiquetas</title>
    <style>
      * {
        margin: 0;
        padding: 0;
      }
      .card-body {
        padding: 5px;
      }
      .form {
        margin: auto;
        padding: 20px;
        width: 700px;
        background-color: rgb(235, 235, 235);
      }
      .desing {
        width: 300px;
        margin: auto;
      }
      .code {
        font-size: 55px;
        height: 75px;
        font-weight: bold;
        padding: 0;
        margin: 0;
        text-align: center;
      }
      .barCode {
        text-align: center;
        margin: 0;
        padding: 0;
        height: 45px;
      }
      svg {
        width: 120px;
        height: 60px;
      }
      .tabla {
        position: relative;
        width: 100%;
        display: block;
        text-align: -webkit-center;
      }
      table {
        position: relative;
        font-size: 12px;
        width: 35%;
        text-align: center;
      }
      table,
      td {
        border: 1px solid black;
        border-collapse: collapse;
      }
      th {
        font-size: 8px;
      }
      #position {
        font-size: 17px;
        font-weight: bold;
      }

      @media print {
        @page {
          size: landscape;
          width: 80mm;
          height: 50mm;
          margin: 0;
          padding: 0;
        }
        .form {
          display: none;
        }
        .desing {
          visibility: visible;
        }
      }
    </style>
  </head>
  <body>
    <div>
      <div class="form">
        <div class="bottons" style="display: flex; padding: 0 30px; justify-content: center">
          <div>
            <a class="btn btn-primary" style="width: 170px; margin: 0 10px" href="index.html">Completa</a>
          </div>
          <div>
            <a class="btn btn-primary" style="width: 170px; margin: 0 10px" tabindex="6" href="#">Vacia</a>
          </div>
          <div>
            <a class="btn btn-primary" style="width: 170px; margin: 0 10px" tabindex="6" href="#">Ofisnack</a>
          </div>
        </div>

        <header class="row mt-3" style="display: flex">
          <div class="col-2">
            <img src="logo_1.png" alt="Logo" width="120" onerror="this.style.display='none'" />
          </div>
          <div class="titulo col-10" style="text-align: center; margin-top: 10px">
            <h1>Impresión de Etiquetas Zebra</h1>
          </div>
        </header>

        <div class="row g-3 mt-2">
          <div class="col-6">
            <input
              type="text"
              class="form-control"
              placeholder="Ingrese el código del artículo"
              aria-label="code"
              onchange="refresData(this)"
              tabindex="1"
            />
          </div>
          <div class="col-6">
            <input
              type="text"
              class="form-control"
              placeholder="Posición"
              aria-label="position"
              onchange="refresData(this)"
              tabindex="5"
            />
          </div>
        </div>
        <br />
        <div>
          <button onclick="imprimir()" class="btn btn-primary" style="width: 170px" tabindex="6">
            Imprimir
          </button>
          <br />
          <span style="font-size: 12px">Para imprimir podes seleccionar <code>Ctrl+Enter</code></span>
        </div>
      </div>

      <div class="desing mt-4">
        <div class="card" id="tema1">
          <div class="card-body">
            <section class="card-text row">
              <p class="barCode col-12">
                <svg id="barcode"></svg>
              </p>
              <p class="code col-12" id="code">000-000</p>
            </section>
            <section class="tabla">
              <table>
                <thead>
                  <tr>
                    <th>Posición</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td id="position">A1 01</td>
                  </tr>
                </tbody>
              </table>
            </section>
          </div>
        </div>
      </div>
    </div>

    <!-- Carga de JsBarcode por CDN Web -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

    <script>
      function imprimir() {
        window.print();
      }

      // Inicializa el código de barras predeterminado
      try {
        JsBarcode("#barcode", "000-000", {
          width: 2,
          height: 60,
          displayValue: false
        });
      } catch (e) {
        console.error(e);
      }

      function refresData(e) {
        const targetId = e.getAttribute("aria-label");
        const val = e.value.toUpperCase();

        if (targetId && document.getElementById(targetId)) {
          document.getElementById(targetId).innerText = val;
        }

        if (targetId === "code" && val.trim() !== "") {
          try {
            JsBarcode("#barcode", val, {
              width: 2,
              height: 60,
              displayValue: false
            });
          } catch (err) {
            console.log("Código no válido para código de barras");
          }
        }
      }

      document.addEventListener("keydown", (e) => {
        if (e.ctrlKey && e.key === "Enter") {
          imprimir();
        }
      });
    </script>
  </body>
</html>
